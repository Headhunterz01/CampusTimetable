<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="@drawable/widget_surface">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_today" android:textSize="20sp" android:textStyle="bold" android:textColor="#1D1B20" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="12sp" android:textColor="#615B68" />
    <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="@string/widget_example" android:textSize="17sp" android:textColor="#6750A4" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_preview_time" android:textSize="14sp" android:textColor="#615B68" />
</LinearLayout>
